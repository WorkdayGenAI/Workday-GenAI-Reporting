         "Report_Name": "Sub Report - Cash Flow (IFRS)",
         "Report_Owner": "tserrano / Teresa Serrano",
         "Report_Type": "Matrix",
         "Used_in_Composite_Report_Definition": "Interim Consolidated Statement of Cash Flow (IFRS)",
         "referenceID": "Journal Lines for Financial Reporting"

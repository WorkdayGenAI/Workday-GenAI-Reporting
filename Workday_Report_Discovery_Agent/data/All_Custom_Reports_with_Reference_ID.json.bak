      {
         "Brief_Description": "Journal lines translated with eliminations.  Does not calculate current year retained earnings.",
         "DS_Description": "Accesses the Journal Line as its primary object. A data source filter is required to be selected prior to running reports. The filters use Reporting Time Periods so that reports can be designed based on relative time spans.\nThe results will only include journal lines for journals that are in Posted or Proforma status, e.g. it automatically excludes journals that have been cancelled or are in error or draft status. This Data Source has the ability to create derived Journal Lines for financial reporting calculations similar to amounts reported by Trial Balance or Financial Statement. The derived journal lines can include system calculated amounts for currency translation gain or loss, Intercompany and Interworktag Eliminations and Eliminations Variance, and aggregated Current Year Retained Earnings.",
         "Data_Source_Filter": "Journal Lines for Company and Reporting Time Period",
         "Fields_Displayed_on_Report": "GMS Company Hierarchy; Ledger Account; Translated Debit Minus Credit Amount; Company; Revenue Category",
         "Fields_Referenced_in_Report": "Training Org.; Journal; Cost Center; Book Codes IN Book  for RDS Filter; Job; Accounting Date; Ledger Account; Transaction Debit minus Credit; Transaction Currency; Book Codes Not In Book for RDS Filter; Intercompany Affiliate; Period; Journal Status; Translated Debit Minus Credit Amount; Company; Year; Supplier as Worktag; Sales Item; Book Code; Pay Component; Campus; Job Profile; Division; Business Document; Campaign; Line of Business; Worktags; Location; Bank Account; Customer; Journal Source; Expense Item as Worktag; Project; Worker; Region; Spend Category as Worktag; Revenue Category",
         "Report_Name": "Sub Report - Journal Lines Translated with Eliminations - Consolidation Hierarchy",
         "Report_Owner": "tserrano / Teresa Serrano",
         "Report_Type": "Matrix",
         "Used_in_Composite_Report_Definition": "Consolidated Income Statement - Outlined",
         "referenceID": "Journal Lines for Financial Reporting"
      },

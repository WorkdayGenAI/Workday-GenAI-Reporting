      },
      {
         "Brief_Description": "This report is to be used with Workday's delivered trial balance report.",
         "DS_Description": "Accesses the Journal Line as its primary object. A data source filter is required to be selected prior to running reports. The filters use Reporting Time Periods so that reports can be designed based on relative time spans.\nThe results will only include journal lines for journals that are in Posted or Proforma status, e.g. it automatically excludes journals that have been cancelled or are in error or draft status. This Data Source has the ability to create derived Journal Lines for financial reporting calculations similar to amounts reported by Trial Balance or Financial Statement. The derived journal lines can include system calculated amounts for currency translation gain or loss, Intercompany and Interworktag Eliminations and Eliminations Variance, and aggregated Current Year Retained Earnings.",
         "Data_Source_Filter": "Journal Lines for Company and Reporting Time Period",
         "Fields_Displayed_on_Report": "Ledger Account; Translated Debit Minus Credit Amount; Translated Debit Amount; Translated Credit Amount",
         "Fields_Referenced_in_Report": "Journal; Cost Center; Book Codes IN Book  for RDS Filter; Accounting Date; Ledger Account; Investor; Transaction Currency; Book Codes Not In Book for RDS Filter; Intercompany Affiliate; Investment Pool; Period; Sponsor; Journal Status; Translated Debit Minus Credit Amount; Company; Translated Debit Amount; Year; Translation Currency; Translated Credit Amount; Supplier as Worktag; Gift; Book Code; Business Unit; Sales Item; Grant; Pay Component; Worktags; Location; Bank Account; Customer; Fund; Journal Source; Expense Item as Worktag; Project; Region; Spend Category as Worktag; Revenue Category",
         "Report_Name": "Trial Balance - Composite - KSK-Sub Report - Journal Lines Translated for Trial Balance",
         "Report_Owner": "KSantosh-trn / Santosh Kasamshetty",
         "Report_Type": "Matrix",
         "Used_in_Composite_Report_Definition": "Trial Balance - Composite - KSK",
         "referenceID": "Journal Lines for Financial Reporting"
      },
      {
         "Brief_Description": "View a trial balance for a Company or Company Hierarchy. The trial balance displays the beginning balance, debit amount, credit amount, and ending balance. If the reporting currency is different from any of the company currencies translation occurs and an account translation rule set is required. Any differences in currency due to varying rates from different periods will display in a separate column, Translation Adjustment.\n\nRequired prompts: Company, Ledger, Time Period, Period, Translation Currency, Account Translation Rule Set.\n\nOptional prompts: Book, Ledger Accounts and Summaries, Worktags, Balancing Worktags, Additional Options, Perform Intercompany Eliminations, Perform Interworktag Eliminations",
         "Fields_Referenced_in_Report": "Today",
         "Report_Name": "Trial Balance - Composite - KSK",
         "Report_Owner": "KSantosh-trn / Santosh Kasamshetty",
         "Report_Type": "Composite",
         "Sub-Reports": "Trial Balance - Composite - KSK-Sub Report - Journal Lines Translated for Trial Balance"
      },
